# Copy to .env and adjust. All variables are optional.
# Folder for the database, logs, backups and later raw snapshots (relative to the working directory).
DEALRADAR_DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR
DEALRADAR_LOG_LEVEL=INFO
# Seconds a writer waits for the single-writer lock before giving up.
DEALRADAR_LOCK_TIMEOUT_S=10

# Optional: Telegram notifications through the free Telegram Bot API.
# Create a bot with @BotFather, send it a message, then put the token and your chat id here.
# Leave empty to keep notifications in the app only. The token is a secret - never commit .env.
DEALRADAR_TELEGRAM_BOT_TOKEN=
DEALRADAR_TELEGRAM_CHAT_ID=
